{
  "schemaVersion": 1,
  "id": "saltlyrics",
  "version": "${version}",
  "name": "Salt Lyrics · 盐词",
  "description": "Salt Player 的独立 Minecraft 3D 歌词显示模组。",
  "authors": [
    "Luoning77"
  ],
  "contributors": [
    "Sorihiko and DangoMusic contributors (derived rendering code)"
  ],
  "license": "GPL-3.0-only",
  "contact": {
    "homepage": "https://github.com/Luoning77/saltlyrics",
    "sources": "https://github.com/Luoning77/saltlyrics",
    "issues": "https://github.com/Luoning77/saltlyrics/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.luoning.saltlyrics.SaltLyricsClient"
    ],
    "modmenu": [
      "com.luoning.saltlyrics.compat.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "modmenu": "*"
  },
  "mixins": [
    "saltlyrics.mixins.json"
  ],
  "icon": "assets/saltlyrics/icon.png"
}
